{
  "name": "dsh-voice-assistant",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "sdk-snapshot.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "runtime",
    "RESIDENT_ACCEPTANCE.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host-contract": "node --test tests/host-*.integration.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-alpha.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "esbuild": "^0.27.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "zod": "4.6.7"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "3.1.1"
  }
}
